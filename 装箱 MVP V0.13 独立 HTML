function download(bytes,name,type){const url=URL.createObjectURL(new Blob([bytes],{type}));const a=document.createElement('a');a.href=url;a.download=name;root.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),2000);}
function xlsx(sheets,name){download(window.PackXlsx.write(sheets),name,'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet');}
const delay=ms=>new Promise(resolve=>setTimeout(resolve,ms));
async function withFileProgress(kind,task){if(fileBusy)throw new Error('请等待当前文件处理完成。');fileBusy=true;const run=++progressRun,started=performance.now();const label=kind==='upload'?'现在正在上传':'现在正在导出中';const box=$('#p-file-progress');box.hidden=false;box.dataset.failed='false';$('#p-loader-label').textContent=label;$('#p-loader-note').textContent='模拟进度 · 文件在当前页面处理';let value=5;const paint=()=>{$('#p-loader-value').textContent=Math.round(value)+'%';$('#p-loader-bar').style.width=value+'%';$('#p-loader-progress').setAttribute('aria-valuenow',String(Math.round(value)));};paint();$('#p-file').disabled=true;$('#p-template').disabled=true;$('#p-export').disabled=true;const timer=setInterval(()=>{value=Math.min(92,value+(94-value)*.19);paint();},120);try{await delay(30);const output=await task();await delay(Math.max(0,750-(performance.now()-started)));clearInterval(timer);value=100;paint();$('#p-loader-label').textContent=kind==='upload'?'上传处理完成':'导出文件已生成';$('#p-loader-note').textContent=kind==='upload'?'模拟进度 · 请检查清单并确认入库':'模拟进度 · 已发起下载，请查看浏览器下载列表';setTimeout(()=>{if(run===progressRun)box.hidden=true;},1200);return output;}catch(e){clearInterval(timer);box.dataset.failed='true';$('#p-loader-label').textContent=(kind==='upload'?'上传失败':'导出失败')+'：'+e.message;$('#p-loader-note').textContent='模拟进度 · 本次处理未完成';throw e;}finally{fileBusy=false;$('#p-file').disabled=false;$('#p-template').disabled=false;$('#p-export').disabled=!result;}}
$('#p-template').addEventListener('click',async()=>{try{await withFileProgress('export',()=>xlsx([{name:'进货单',rows:[['型号','售价（元/件）','单位重量（kg/件）','入库数量（件）','单位体积（m³/件）'],['示例型号 A',130,10,30,''],['示例型号 B',175,12,24,'']]},{name:'填写说明',rows:[['以上为可修改示例，不是固定业务数值。'],['第一行为列名；新增产品须有售价、单位重量和入库数量。'],['单位体积为可选列，单位 m³/件。留空时保留已有产品的体积，新产品暂不填写。'],['库存按同型号累加；同一文件不会重复入库。'],['重量单位 kg，最多三位小数；数量为非负整数。']]}],'进货单模板.xlsx'));}catch(e){toast('#p-inv-toast',e.message);}});
$('#p-export').addEventListener('click',async()=>{compute();if(!result)return;const snapshot={rows:clone(readRows()),result:clone(result),original:inputTotals(),capacity:state.capacity,index:selectedIndex,count:candidates.plans.length,complete:candidates.complete};try{await withFileProgress('export',()=>{const rows=snapshot.rows,result=snapshot.result,original=snapshot.original,volume=volumeSummary(rows,result),last=rows.length+1,quantity=result.quantities.reduce((sum,q)=>sum+q,0),body=[['型号','单位重量（kg/件）','售价（元/件）','建议数量（件）','装载重量（kg）','金额（元）','单位体积（m³/件）','装载体积（m³）','原数量（件）','建议变更（件）','调整方式']];rows.forEach((r,i)=>{const n=i+2,q=result.quantities[i],v=r.volume==null||r.volume===''?null:Number(r.volume);body.push([r.name,r.weight,r.price,q,{formula:`B${n}*D${n}`,value:r.weight*q},{formula:`C${n}*D${n}`,value:r.price*q},v===null?'':v,{formula:`IF(D${n}=0,0,IF(G${n}="","待完善体积",G${n}*D${n}))`,value:q===0?0:v===null?'待完善体积':v*q},r.quantity,q-r.quantity,r.locked?'锁定':r.priority?'优先增减':'常规']);});body.push(['合计','','',{formula:`SUM(D2:D${last})`,value:quantity},{formula:`SUM(E2:E${last})`,value:result.weight},{formula:`SUM(F2:F${last})`,value:result.revenue},'',{formula:`IF(COUNTIF(H2:H${last},"待完善体积")>0,"待完善体积",SUM(H2:H${last}))`,value:volume.value===null?'待完善体积':volume.value},{formula:`SUM(I2:I${last})`,value:original.quantity},{formula:`SUM(J2:J${last})`,value:quantity-original.quantity},'']);xlsx([{name:'装箱清单',rows:body},{name:'方案汇总',rows:[['指标','结果'],['目标重量（kg）',snapshot.capacity],['建议装载重量（kg）',{formula:`SUM('装箱清单'!E2:E${last})`,value:result.weight}],['销售额（元）',{formula:`SUM('装箱清单'!F2:F${last})`,value:result.revenue}],['剩余容量（kg）',{formula:'B2-B3',value:result.remaining}],['每千克金额（元/kg）',{formula:'IFERROR(B4/B3,0)',value:result.weight?result.revenue/result.weight:0}],['装载体积（m³）',{formula:`IF(COUNTIF('装箱清单'!H2:H${last},"待完善体积")>0,"待完善体积",SUM('装箱清单'!H2:H${last}))`,value:volume.value===null?'待完善体积':volume.value}],['原方案重量（kg）',{formula:`SUMPRODUCT('装箱清单'!B2:B${last},'装箱清单'!I2:I${last})`,value:original.weight}],['重量变化（kg）',{formula:'B3-B8',value:Math.round((result.weight-original.weight)*1000)/1000}],['原数量合计（件）',{formula:`SUM('装箱清单'!I2:I${last})`,value:original.quantity}],['建议数量合计（件）',{formula:`SUM('装箱清单'!D2:D${last})`,value:quantity}],['体积状态',volume.missing.length?volume.missing.join('、')+' 未填写单位体积':'完整'],['方案序号',snapshot.index+1],['展示最优方案数',snapshot.count],['方案范围',snapshot.complete?'全部最优数量组合':'最多十个最优代表组合'],['说明','采用当前建议数量与最新产品信息；合计公式不重复计算合计行。原方案、建议和目标重量并列复核；体积仅统计，缺失值不视为零，本文件不含宏。']]}],'装箱清单.xlsx');});toast('#p-packing-toast','已生成当前建议的装箱清单，下载已发起。');}catch(e){toast('#p-packing-toast','导出失败：'+e.message);}});
function copyText(){const rows=readRows(),original=inputTotals(),volume=volumeSummary(rows,result),quantity=result.quantities.reduce((sum,q)=>sum+q,0),clean=v=>{const text=String(v??'').replace(/[\t\r\n]+/g,' ');return typeof v==='string'&&/^[=+@-]/.test(text)?"'"+text:text;},body=[['型号','单位重量（kg/件）','售价（元/件）','建议数量（件）','装载重量（kg）','金额（元）','单位体积（m³/件）','装载体积（m³）','原数量（件）','建议变更（件）','调整方式']];rows.forEach((r,i)=>{const q=result.quantities[i],v=r.volume==null||r.volume===''?null:Number(r.volume);body.push([r.name,r.weight,r.price,q,Number((r.weight*q).toFixed(3)),Number((r.price*q).toFixed(2)),v===null?'待完善':v,q===0?0:v===null?'待完善体积':Number((v*q).toFixed(8)),r.quantity,q-r.quantity,r.locked?'锁定':r.priority?'优先增减':'常规']);});body.push(['合计','','',quantity,result.weight,result.revenue,'',volume.value===null?'待完善体积':volume.value,original.quantity,quantity-original.quantity,''],[],['原方案重量（kg）',original.weight],['建议装载重量（kg）',result.weight],['目标重量（kg）',state.capacity],['重量变化（kg）',Math.round((result.weight-original.weight)*1000)/1000],['原数量合计（件）',original.quantity],['建议数量合计（件）',quantity],['装载体积（m³）',volume.value===null?'待完善体积':volume.value],['预计销售额（元）',result.revenue],['每千克金额（元/kg）',result.weight?Number((result.revenue/result.weight).toFixed(2)):0],['剩余容量（kg）',result.remaining]);return body.map(row=>row.map(clean).join('\t')).join('\n');}
$('#p-copy').addEventListener('click',async()=>{compute();if(!result)return;const text=copyText();$('#p-copy-panel').hidden=true;let copied=false;try{if(navigator.clipboard?.writeText){await navigator.clipboard.writeText(text);copied=true;}}catch(e){}if(!copied){const field=$('#p-copy-text');field.value=text;$('#p-copy-panel').hidden=false;field.focus();field.select();try{copied=document.execCommand('copy');}catch(e){}if(copied)$('#p-copy-panel').hidden=true;}toast('#p-packing-toast',copied?'装箱清单已复制，可直接粘贴到 Excel。':'请在下方选中清单，手动复制。');});
function renderProducts(){$('#p-products').innerHTML=state.products.map((p,i)=>`<tr data-item-id="${esc(p.id)}"><td data-label="型号"><input data-product="${i}" data-pfield="name" value="${esc(p.name)}" aria-label="产品${i+1}型号"></td><td data-label="单重 / kg"><input data-product="${i}" data-pfield="weight" type="number" min="0.001" step="0.001" value="${esc(p.weight??'')}" aria-label="产品${i+1}单位重量"></td><td data-label="单位体积 / m³"><input data-product="${i}" data-pfield="volume" type="number" min="0" step="any" placeholder="可留空" value="${esc(p.volume??'')}" aria-label="产品${i+1}单位体积"></td><td data-label="售价 / 元"><input data-product="${i}" data-pfield="price" type="number" min="0" step="0.01" value="${esc(p.price??'')}" aria-label="产品${i+1}售价"></td><td data-label="库存 / 件"><input data-product="${i}" data-pfield="stock" type="number" min="0" step="1" value="${esc(p.stock??'')}" aria-label="产品${i+1}库存"></td><td data-label="操作"><div class="p-list-actions"><button class="p-btn" data-product-move="${i}" data-direction="-1" type="button" ${i===0?'disabled':''} aria-label="产品${i+1}上移">上移</button><button class="p-btn" data-product-move="${i}" data-direction="1" type="button" ${i===state.products.length-1?'disabled':''} aria-label="产品${i+1}下移">下移</button><button class="p-btn p-delete-btn" data-product-delete="${i}" type="button" aria-label="删除产品${i+1}">删除</button></div></td></tr>`).join('')||'<tr class="p-empty-row"><td colspan="6">还没有产品。点击「新增产品」，或上传 XLSX 进货单。</td></tr>';$('#p-product-count').textContent=`${state.products.length} 个型号`;$('#p-receipts').innerHTML=state.receipts.length?state.receipts.slice(-4).reverse().map(r=>`<p>${esc(r.name)} · ${r.lines} 行 · +${fmt(r.quantity,0)} 件</p>`).join(''):'还没有导入进货单。';renderSortControls();renderDeleteConfirmation();}
function renderDeleteConfirmation(){const product=state.products.find(p=>p.id===pendingDeleteId);$('#p-delete-confirm').hidden=!product;if(product){const references=state.rows.filter(r=>r.id===product.id).length;$('#p-delete-message').textContent=references?`「${product.name}」正在本次装箱中使用。删除产品后，也会移除对应的 ${references} 行装箱货品。确定删除吗？`:`确定删除产品「${product.name}」吗？`;}}
function removeProduct(id){const product=state.products.find(p=>p.id===id);if(!product)return;state.products=state.products.filter(p=>p.id!==id);state.rows=state.rows.filter(r=>r.id!==id);state.selectedPlanKey=null;pendingDeleteId=null;persist();renderProducts();renderRows();compute();toast('#p-inv-toast','已删除产品「'+product.name+'」。');}
$('#p-products').addEventListener('click',e=>{const move=e.target.closest('[data-product-move]'),remove=e.target.closest('[data-product-delete]');if(move){moveItem('product',Number(move.dataset.productMove),Number(move.dataset.direction));return;}if(!remove)return;const product=state.products[Number(remove.dataset.productDelete)];if(!product)return;if(state.rows.some(r=>r.id===product.id)){pendingDeleteId=product.id;renderDeleteConfirmation();}else removeProduct(product.id);});
$('#p-delete-confirm-button').addEventListener('click',()=>{if(pendingDeleteId)removeProduct(pendingDeleteId);});$('#p-delete-cancel-button').addEventListener('click',()=>{pendingDeleteId=null;renderDeleteConfirmation();});
$('#p-products').addEventListener('change',e=>{const i=e.target.dataset.product,f=e.target.dataset.pfield;if(i===undefined)return;const p=state.products[i],value=f==='name'?e.target.value.trim():(e.target.value===''?null:Number(e.target.value));let error='';if(f==='name'&&(!value||state.products.some((x,j)=>j!==Number(i)&&x.name===value)))error='型号不能为空或重复。';if(f==='price'&&(!Number.isFinite(value)||value<0))error='售价须为非负数。';if(f==='weight'&&(!Number.isFinite(value)||value<=0||Math.abs(value*1000-Math.round(value*1000))>1e-6))error='重量须为正数，最多保留三位小数。';if(f==='volume'&&value!==null&&(!Number.isFinite(value)||value<0))error='单位体积须为非负数，也可留空。';if(f==='stock'&&(!Number.isSafeInteger(value)||value<0))error='库存须为非负整数。';if(error){toast('#p-inv-toast',error);renderProducts();return;}p[f]=value;if(sortSetting('product').field===f)sortSetting('product').field='manual';if(f==='name'&&sortSetting('packing').field==='name')sortSetting('packing').field='manual';persist();renderSortControls();renderRows();compute();toast('#p-inv-toast','货品信息已保存，装箱方案与导出清单已同步更新。');});
$('#p-add-product').addEventListener('click',()=>{let n=state.products.length+1;while(state.products.some(p=>p.name==='新型号 '+n))n++;let id='p'+Date.now();while(state.products.some(p=>p.id===id))id+='x';state.products.push({id,name:'新型号 '+n,price:0,weight:1,stock:0,volume:null});sortSetting('product').field='manual';persist();renderProducts();renderRows();compute();});
function showImportError(msg){$('#p-import-error').hidden=!msg;$('#p-import-error').textContent=msg;}
function fingerprint(bytes){let h=2166136261;for(const v of new Uint8Array(bytes)){h^=v;h=Math.imul(h,16777619);}return bytes.byteLength+'-'+(h>>>0).toString(16);}
const aliases={name:['型号','产品型号','sku','商品型号','名称'],price:['售价','单价','售价元件','销售价','price'],weight:['单位重量','单件重量','重量kg','单位重量kg件','weight'],volume:['单位体积','单件体积','体积','volume'],quantity:['入库数量','采购数量','数量','库存数量','入库数量件','quantity']};const fieldNames={name:'型号',price:'售价（元/件）',weight:'单位重量（kg/件）',quantity:'入库数量（件）',volume:'单位体积（m³/件，可选）'};
function norm(s){return String(s??'').trim().toLowerCase().replace(/[\s（）()\/／_-]/g,'');}
$('#p-file').addEventListener('change',async e=>{const f=e.target.files[0];if(!f)return;showImportError('');$('#p-import-panel').hidden=true;pendingImport=null;try{const parsed=await withFileProgress('upload',async()=>{if(!/\.xlsx$/i.test(f.name))throw new Error('请选择 .xlsx 文件；不执行宏。');const bytes=await f.arrayBuffer();const hash=fingerprint(bytes);if(state.receipts.some(r=>r.hash===hash))throw new Error('这个文件已经入库，本次没有重复增加库存。');const data=await window.PackXlsx.read(bytes);if(!data.sheets.length)throw new Error('文件没有可读取的工作表。');return {data,hash};});const {data,hash}=parsed;pendingImport={data,name:f.name,hash,index:0,mapping:{},valid:null};const preferred=data.sheets.findIndex(s=>/进货|入库/.test(s.name));pendingImport.index=Math.max(0,preferred);$('#p-sheet').innerHTML=data.sheets.map((s,i)=>`<option value="${i}">${esc(s.name)}</option>`).join('');$('#p-sheet').value=String(pendingImport.index);$('#p-import-title').textContent='检查进货单：'+f.name;$('#p-import-panel').hidden=false;renderMapping();}catch(err){showImportError(err.message);}finally{e.target.value='';}});
function renderMapping(){const s=pendingImport.data.sheets[pendingImport.index],heads=s.rows[0]||[];pendingImport.mapping={};Object.keys(fieldNames).forEach(key=>{let index=heads.findIndex(h=>aliases[key].some(a=>norm(h)===a||norm(h).startsWith(a)));pendingImport.mapping[key]=index;});$('#p-mapping').innerHTML=Object.entries(fieldNames).map(([k,label])=>`<label><span class="p-label">${label}</span><select data-map="${k}"><option value="-1">${k==='volume'?'无此列，保留已有体积':'选择对应列'}</option>${heads.map((h,i)=>`<option value="${i}" ${pendingImport.mapping[k]===i?'selected':''}>${esc(h||'空列 '+(i+1))}</option>`).join('')}</select></label>`).join('');validateImport();}
$('#p-sheet').addEventListener('change',e=>{pendingImport.index=Number(e.target.value);renderMapping();});$('#p-mapping').addEventListener('change',e=>{if(!e.target.dataset.map)return;pendingImport.mapping[e.target.dataset.map]=Number(e.target.value);validateImport();});
function validateImport(){pendingImport.valid=null;$('#p-import-confirm').disabled=true;const m=pendingImport.mapping,required=['name','price','weight','quantity'],mapped=Object.values(m).filter(i=>i>=0);if(required.some(k=>m[k]<0)||new Set(mapped).size!==mapped.length){$('#p-import-summary').textContent='请为型号、售价、单位重量和数量选择不同的列；单位体积可选。';return;}try{const raw=pendingImport.data.sheets[pendingImport.index].rows.slice(1),merged=new Map();let nonempty=0;raw.forEach((row,i)=>{if(!row.some(c=>c!==null&&c!==undefined&&String(c).trim()!==''))return;nonempty++;const name=String(row[m.name]??'').trim(),quantity=Number(row[m.quantity]),price=Number(row[m.price]),weight=Number(row[m.weight]),hasVolume=m.volume>=0&&row[m.volume]!==null&&row[m.volume]!==undefined&&String(row[m.volume]).trim()!=='',volume=hasVolume?Number(row[m.volume]):null;if(!name||[m.quantity,m.price,m.weight].some(k=>row[k]===null||row[k]===undefined||String(row[k]).trim()==='')||!Number.isSafeInteger(quantity)||quantity<0||!Number.isFinite(price)||price<0||!Number.isFinite(weight)||weight<=0||Math.abs(weight*1000-Math.round(weight*1000))>1e-6)throw new Error('第 '+(i+2)+' 行：请检查型号、售价、单位重量和整数入库数量。');if(hasVolume&&(!Number.isFinite(volume)||volume<0))throw new Error('第 '+(i+2)+' 行：单位体积须为非负数，也可留空。');const old=merged.get(name);if(old&&(old.price!==price||old.weight!==weight||old.volume!==null&&volume!==null&&old.volume!==volume))throw new Error('同型号存在不同售价、单位重量或体积：'+name);const combined=quantity+(old?.quantity||0),existing=state.products.find(p=>p.name===name);if(!Number.isSafeInteger(combined)||!Number.isSafeInteger(combined+(existing?.stock||0)))throw new Error('入库数量超出可处理范围：'+name);merged.set(name,{name,price,weight,volume:volume??old?.volume??null,quantity:combined});});if(!nonempty)throw new Error('没有可入库的货品行。');pendingImport.valid=[...merged.values()];const total=pendingImport.valid.reduce((a,r)=>a+r.quantity,0);$('#p-import-summary').textContent=`识别 ${pendingImport.valid.length} 个型号，共 ${fmt(total,0)} 件。同型号累加库存并更新售价、重量；有填写的体积会更新，空白保留已有体积，新型号自动创建。`;$('#p-import-confirm').disabled=false;}catch(e){$('#p-import-summary').textContent=e.message;}}
$('#p-import-confirm').addEventListener('click',()=>{validateImport();if(!pendingImport?.valid)return;const list=pendingImport.valid;if(state.receipts.some(r=>r.hash===pendingImport.hash)){showImportError('该文件已入库。');return;}for(const r of list){let p=state.products.find(p=>p.name===r.name);if(p){p.stock+=r.quantity;p.price=r.price;p.weight=r.weight;if(r.volume!==null)p.volume=r.volume;}else{state.products.push({id:'p'+Date.now()+'-'+state.products.length,name:r.name,price:r.price,weight:r.weight,stock:r.quantity,volume:r.volume});}}state.receipts.push({name:pendingImport.name,hash:pendingImport.hash,lines:list.length,quantity:list.reduce((a,r)=>a+r.quantity,0),at:new Date().toISOString()});pendingImport=null;$('#p-import-panel').hidden=true;persist();renderProducts();renderRows();compute();toast('#p-inv-toast','已完成入库，产品信息与可用库存已更新。');});$('#p-import-cancel').addEventListener('click',()=>{pendingImport=null;$('#p-import-panel').hidden=true;});
function renderRequirements(){$('#p-version').textContent=CONTRACT.version;$('#p-rules').innerHTML=CONTRACT.rules.map(r=>'<li>'+esc(r)+'</li>').join('');$('#p-change').value=state.syncRequest?.text||'';$('#p-sync-status').textContent=state.syncRequest&&CONTRACT.handledRequestIds.includes(state.syncRequest.id)?'此请求已合入当前 PRD 与预览。':state.syncRequest?(window.openai?.setWidgetState?'已保存待同步请求，等待文档维护任务处理。':'已保存在本机；请将需求说明交回本对话以同步 PRD。'):'还没有待同步请求。';}
$('#p-change-save').addEventListener('click',()=>{const text=$('#p-change').value.trim();if(!text){toast('#p-sync-status','请先填写需求调整内容。');return;}state.syncRequest={id:'request-'+Date.now(),text,createdAt:new Date().toISOString(),baseVersion:CONTRACT.version};persist();renderRequirements();});
$('#p-export-prd').addEventListener('click',()=>{const md='# 手套装箱 MVP\n\n版本：'+CONTRACT.version+'\n\n'+CONTRACT.rules.map(r=>'- '+r).join('\n')+(state.syncRequest?'\n\n## 待同步需求\n\n'+state.syncRequest.text:'');download(md,'装箱MVP需求说明.md','text/markdown;charset=utf-8');});
function renderAll(){candidateSignature=null;$('#p-capacity').value=state.capacity??'';renderRows();renderProducts();renderRequirements();compute();if(window.openai?.setWidgetState)$('#p-storage-status').textContent='预览数据随 PRD 保存';}
window.PackMvp={getState:()=>clone(state),getResult:()=>result?clone(result):null,getCandidates:()=>candidates?clone(candidates):null,getSelectedIndex:()=>selectedIndex,contract:CONTRACT};renderAll();
})();
</script>
</body></html>