  // spurious tie against 0.3. Extreme precision/magnitudes use the explicitly
  // approximate path instead of claiming an exact floating-point optimum.
  function integerPrices(prices, bounds) {
    var decimals = 0;
    for (var i = 0; i < prices.length; i++) {
