function renderMetrics(plan){const original=inputTotals(),target=state.capacity!==null&&Number.isFinite(state.capacity)&&state.capacity>0?state.capacity:null,weight=plan?.weight??null,change=weight===null||original.weight===null?null:Math.round((weight-original.weight)*1000)/1000;const value=w=>w===null?'—':fmt(w,3)+' <small>kg</small>';const volume=plan?volumeSummary(readRows(),plan):null,pct=plan&&target?Math.min(100,plan.weight/target*100):null,capped=candidates&&(candidates.capped===true||candidates.truncated===true||candidates.complete===false);$('#p-result-body').innerHTML=`<div class="p-weight-comparison"><div><div class="p-muted">原方案重量</div><div class="p-num" id="p-original-weight">${value(original.weight)}</div></div><div><div class="p-muted">建议装载重量</div><div class="p-num" id="p-suggested-weight">${value(weight)}</div></div><div><div class="p-muted">目标重量</div><div class="p-num" id="p-target-weight">${value(target)}</div></div><div class="p-weight-change" id="p-weight-delta">${change===null?'重量变化 —':'较原方案 '+(change>0?'+':'')+fmt(change,3)+' kg'}</div></div><div class="p-summary"><div><div class="p-muted">建议装载率</div><div class="p-num">${pct===null?'—':fmt(pct,1)+' <small>%</small>'}</div><div class="p-track" role="img" aria-label="${pct===null?'尚无建议装载率':'装载率 '+fmt(pct,1)+'%'}"><span class="p-segment" style="width:${pct??0}%"></span></div><div class="p-muted">${plan?'剩余 '+fmt(plan.remaining,3)+' kg':'生成方案后显示装载率'}</div></div><div><div class="p-muted">装载体积</div><div class="p-num" id="p-volume-value">${!volume?'—':volume.value===null?'待完善体积':fmt(volume.value,6)+' <small>m³</small>'}</div><div class="p-muted" id="p-volume-note">${!volume?'生成方案后显示装载体积':volume.missing.length?esc(volume.missing.join('、'))+' 未填写单位体积':'按建议数量汇总'}</div></div><div><div class="p-muted">每千克金额</div><div class="p-num">${plan?'¥'+fmt(plan.weight?plan.revenue/plan.weight:0)+' <small>/ kg</small>':'—'}</div><div class="p-secondary-amount">预计销售额 ${plan?'¥'+fmt(plan.revenue):'—'}</div></div></div>${plan?'<div class="p-result-hint">'+(capped?'展示最多十个最接近目标重量的最优数量组合，均不超重。':'已展示全部最接近目标重量的最优数量组合，均不超重。')+'</div>':''}`;renderQuantityTotals(plan);}
function syncProposalActions(){const active=!!result&&!state.proposalDismissed;$('#p-apply').disabled=!active;$('#p-copy').disabled=!active;$('#p-export').disabled=!active||fileBusy;$('#p-clear-packing').disabled=!state.rows.length;$('#p-discard-plan').disabled=!active;$('#p-regenerate-plan').hidden=!state.proposalDismissed;$('#p-regenerate-plan').disabled=!state.rows.length;$('#p-proposal-notice').hidden=!state.proposalDismissed;renderSortControls();}
function resetProposalDisplay(message,empty=false){result=null;candidates=null;canonicalCandidates=null;candidateSignature=null;$('#p-errors').hidden=!message;$('#p-errors').textContent=message||'';$('#p-mode').textContent=state.proposalDismissed?'方案已放弃':empty?'未添加货品':'等待有效输入';$$('[data-suggestion]').forEach(c=>c.textContent='—');$('#p-mix').disabled=true;$('#p-mix-label').textContent=state.proposalDismissed?'方案已放弃':empty?'暂无方案':'等待有效输入';$('#p-candidate-count').textContent='';$('#p-best-label').textContent='最大装载重量';$('#p-mix-note').textContent='';$('#p-scheme-chart').innerHTML='';$('#p-plan-steps').innerHTML='';$('#p-copy-panel').hidden=true;renderMetrics(null);syncProposalActions();}
function renderSelected(){if(!candidates?.plans.length||state.proposalDismissed)return;const rows=readRows();result=candidates.plans[selectedIndex];const count=candidates.plans.length;$('#p-mix').min='0';$('#p-mix').max=String(count-1);$('#p-mix').step='1';$('#p-mix').value=String(selectedIndex);$('#p-mix').disabled=count<2;$('#p-mix').setAttribute('aria-valuetext',`第 ${selectedIndex+1} / ${count} 个最优方案，重量 ${fmt(result.weight,3)} kg`);$('#p-average-endpoint').textContent=candidates.endpointsCoincide?'平均 / 最大收益同一方案':'平均补全';$('#p-profit-endpoint').textContent=count===1?'唯一方案':candidates.endpointsCoincide?'其他最优组合':'最大收益';$('#p-mix-label').textContent=`第 ${selectedIndex+1} / ${count} 个方案`;$('#p-candidate-count').textContent=`${count} 个最优方案 · ${count} 个离散档位 · 每档一个方案`;$('#p-best-label').textContent=`最大装载重量 · ${(candidates.maxWeightIndices||[]).length} 个点`;const capped=candidates.capped===true||candidates.truncated===true||candidates.complete===false;$('#p-mix-note').textContent=(selectedIndex===candidates.averageIndex?'当前为平均补全推荐。':selectedIndex===candidates.profitIndex?'当前为最大收益推荐。':'当前为最大装载重量的可选组合。')+' 拖动后吸附到离散点，点选下方序号或方向键逐个选择。'+(capped?' 最优组合较多，展示最多十个代表方案。':' 已展示全部最优组合。');$('#p-plan-steps').style.setProperty('--p-steps',String(count));$('#p-plan-steps').innerHTML=candidates.plans.map((p,i)=>`<button type="button" class="p-plan-step" data-select-plan="${i}" aria-pressed="${i===selectedIndex}" aria-label="选择第 ${i+1} 个方案${i===candidates.averageIndex?'，平均补全':i===candidates.profitIndex?'，最大收益':''}" title="方案 ${i+1} · ${fmt(p.weight,3)} kg">${i+1}</button>`).join('');$('#p-errors').hidden=true;$('#p-mode').textContent=result.mode==='add'?'增重优化':result.mode==='remove'?'减重优化':'已达目标';$$('[data-suggestion]').forEach(cell=>{const i=Number(cell.dataset.suggestion),d=result.deltas[i];cell.innerHTML=`${fmt(result.quantities[i],0)}<span class="p-delta ${d<0?'p-delta-minus':''}">${d>0?'补 '+fmt(d,0)+' 件':d<0?'减 '+fmt(-d,0)+' 件':'不变'}${rows[i].locked?' · 已锁定':''}</span>`;});renderMetrics(result);syncProposalActions();drawCandidates();}
function compute(){if(state.proposalDismissed){resetProposalDisplay('',!state.rows.length);return;}try{const rows=readRows();if(state.capacity===null||rows.some(r=>r.quantity===null||r.price===null||r.weight===null))throw new Error('请填写目标重量和数量，并在货品维护中填写单重与售价。');if(!Number.isFinite(state.capacity)||state.capacity<=0)throw new Error('目标装载重量须大于零。');const canonicalRows=rows.slice().sort((a,b)=>a.id<b.id?-1:a.id>b.id?1:0),signature=JSON.stringify([canonicalRows,state.capacity]);if(signature!==candidateSignature){if(!window.PackCandidates)throw new Error('方案求解模块尚未加载。');const next=window.PackCandidates.build(canonicalRows,state.capacity);if(!next.plans?.length)throw new Error('当前输入没有可行的装箱方案。');canonicalCandidates=next;canonicalIds=canonicalRows.map(r=>r.id);candidateSignature=signature;const rememberedKey=normalizePlanKey(state.selectedPlanKey),remembered=rememberedKey?next.plans.findIndex(p=>planKey(canonicalRows,p)===rememberedKey):-1;selectedIndex=remembered>=0?remembered:Math.round(Math.max(0,Math.min(100,state.mix||0))/100*(next.plans.length-1));}candidates=remapCandidates(rows);renderSelected();}catch(e){resetProposalDisplay(state.rows.length?e.message:'',!state.rows.length);}}
$('#p-clear-packing').addEventListener('click',()=>{state.rows=[];state.selectedPlanKey=null;state.mix=0;state.proposalDismissed=false;sortSetting('packing').field='manual';selectedIndex=0;persist();renderRows();compute();toast('#p-packing-toast','本次装箱货品已清空。');});
$('#p-discard-plan').addEventListener('click',()=>{if(!result)return;state.proposalDismissed=true;state.selectedPlanKey=null;persist();compute();toast('#p-packing-toast','已放弃当前未应用方案。');});
$('#p-regenerate-plan').addEventListener('click',()=>{state.proposalDismissed=false;candidateSignature=null;persist();compute();toast('#p-packing-toast',result?'已重新生成装箱方案。':'请补全有效输入后再生成方案。');});
